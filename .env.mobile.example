# ==============================================================================
# JanSetu Mobile Application (Expo) — Environment Configuration (.env.example)
# ==============================================================================
# Place in apps/mobile/.env or root .env (Expo mode)
# Variables exposed to React Native must begin with EXPO_PUBLIC_

# Backend server URL (Use LAN IP e.g. http://192.168.1.X:3000 or ngrok when testing on physical device)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_COMPLAINT_SERVER_URL=http://localhost:3000

# WebSocket URL for real-time mobile push updates
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Optional Sentry DSN for mobile crash reporting and telemetry (gracefully disabled when unset)
EXPO_PUBLIC_SENTRY_DSN=

# Admin PIN for local administrative authentication (replaces hardcoded value)
EXPO_PUBLIC_ADMIN_PIN=
