# ==============================================================================
# JanSetu Multiverse — Root Umbrella Environment Configuration (.env.example)
# ==============================================================================
# This template outlines all environment variables utilized across the JanSetu Multiverse.
# Copy relevant blocks into application-specific .env files or set in your deployment platform.
# DO NOT COMMIT REAL SECRETS OR CREDENTIAL VALUES TO VERSION CONTROL.
#
# Free-Tier Stack: Neon Postgres + Cloudflare Workers/Pages + Upstash Redis/QStash
#                  + Cloudflare R2 + Ably Realtime + Google Gemini / Groq
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Engine (apps/api — Cloudflare Workers / Node.js Hono Server)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Neon Serverless PostgreSQL Database Connection String (PostGIS enabled)
DATABASE_URL=postgresql://jansetu_owner:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/jansetu?sslmode=require

# Upstash Redis (Sliding-window edge IP rate limiter)
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_sample_token

# Upstash QStash (Asynchronous AI triage queue & 15-min SLA cron scanner)
QSTASH_TOKEN=ey_sample_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_current_sample
QSTASH_NEXT_SIGNING_KEY=sig_next_sample
QSTASH_URL=https://qstash.upstash.io/v2

# Better Auth Session & Authentication Security
BETTER_AUTH_SECRET=jansetu-multiverse-development-secret-key-32chars
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Cloudflare R2 Object Storage (Citizen hazard photos, voice recordings, RTI PDFs)
R2_ACCOUNT_ID=sample_cf_account_id
R2_ACCESS_KEY_ID=sample_r2_access_key
R2_SECRET_ACCESS_KEY=sample_r2_secret_key
R2_BUCKET_NAME=jansetu-media
R2_PUBLIC_URL=https://media.jansetu.gov.in

# Ably Realtime WebSockets (Live complaint lifecycle tracking & officer push alerts)
ABLY_API_KEY=sample_app_id.sample_key_id:sample_secret

# AI Gateway (Classification, Urgency, Vision Hazard Check, RTI Section 6(1) Drafter)
# Free Developer Tier Keys (If omitted, automatic rule- & template-based fallback activates)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
SARVAM_API_KEY=
AI_TIMEOUT_MS=8000

# IoT Hardware & Edge Gateway Cryptographic Security
DEVICE_HMAC_SECRET=jansetu-iot-dev-secret

# ------------------------------------------------------------------------------
# 2. Web Frontend (apps/web — Vite + React 18 + Tailwind CSS)
# ------------------------------------------------------------------------------
VITE_API_BASE=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_ABLY_KEY_PUBLISHABLE=
VITE_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 3. Mobile Application (apps/mobile — Expo SDK 52 + React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ABLY_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 4. IoT Edge Gateway (iot/python — Linux MPU Edge Agent)
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:3000
DEVICE_UID=UNO_Q_01
HMAC_SECRET=jansetu-iot-dev-secret
REQUEST_TIMEOUT=10.0
MAX_BACKOFF_DELAY=60.0
HEARTBEAT_INTERVAL_SEC=30.0
LOG_LEVEL=INFO
