# ==============================================================================
# JanSetu Multiverse — Root Umbrella Environment Configuration (.env.example)
# ==============================================================================
# This template outlines all environment variables utilized across the JanSetu Multiverse.
# Copy relevant blocks into application-specific .env files or set in your deployment platform.
# DO NOT COMMIT REAL SECRETS OR CREDENTIAL VALUES TO VERSION CONTROL.

# ------------------------------------------------------------------------------
# 1. Backend Engine (apps/api or jansetu-backend/)
# ------------------------------------------------------------------------------
# Port the Express + WebSocket server listens on
PORT=3000

# Node execution environment: development | production | test
NODE_ENV=development

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Firebase Firestore Service Account Credentials:
# In Production (Render/Docker): Paste the full JSON string of the service account
FIREBASE_SERVICE_ACCOUNT=

# In Local Development: Path to service account JSON file relative to backend root
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Python executable to spawn for NLP drafting pipelines (python3, /usr/bin/python3, or venv binary)
PYTHON_BIN=python3

# Optional path to local Qwen GGUF model binary
QWEN_MODEL_PATH=ai/models/qwen/Qwen3-0.6B-Q4_0.gguf

# SLA auto-escalation interval threshold in hours
AUTO_ESCALATION_HOURS=48

# WebSocket server heartbeat ping interval in milliseconds
WS_HEARTBEAT_MS=30000

# Legacy Neo4j Connection (Dead code - retained for backward compatibility)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Web Frontend (apps/web or root Vite project)
# ------------------------------------------------------------------------------
# Base API URL for REST endpoints (empty string uses Vite proxy in dev)
VITE_API_BASE=http://localhost:3000

# Backend origin used for WebSocket URL derivation and dashboard RPC
VITE_BACKEND_URL=http://localhost:3000

# Explicit WebSocket URL if separate from HTTP origin
VITE_WS_URL=ws://localhost:3000

# ------------------------------------------------------------------------------
# 3. Mobile Application (apps/mobile or Expo project)
# ------------------------------------------------------------------------------
# Backend HTTP endpoint for mobile client requests (Use machine LAN IP or ngrok for physical devices)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_COMPLAINT_SERVER_URL=http://localhost:3000

# WebSocket endpoint for real-time mobile push updates
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Optional Sentry error monitoring DSN (gracefully disabled when unset)
EXPO_PUBLIC_SENTRY_DSN=

# Admin PIN for local mobile administrative authentication (overrides hardcoded value)
EXPO_PUBLIC_ADMIN_PIN=

# ------------------------------------------------------------------------------
# 4. IoT Edge Gateway (iot/python or IOT/python/)
# ------------------------------------------------------------------------------
# Backend endpoint for sensor fault notifications
BACKEND_URL=http://localhost:3000

# Hardware Device Identifier
DEVICE_ID=UNO_Q_01

# HTTP Request timeout in seconds
REQUEST_TIMEOUT=10.0

# Maximum backoff retry delay in seconds
MAX_BACKOFF_DELAY=60.0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
