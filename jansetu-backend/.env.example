# ==============================================================================
# JanSetu Backend Engine — Environment Configuration (.env.example)
# ==============================================================================
# Place in jansetu-backend/.env or apps/api/.env
# DO NOT COMMIT REAL CREDENTIAL VALUES.

# Server HTTP and WebSocket port
PORT=3000

# Execution environment: development | production | test
NODE_ENV=development

# Allowed CORS origins
CORS_ORIGIN=http://localhost:5173

# Firebase Service Account:
# Production: Stringified JSON string of the service account private key
FIREBASE_SERVICE_ACCOUNT=

# Development: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Python executable to invoke for Grievance & RTI drafting scripts (e.g. python3)
PYTHON_BIN=python3

# Optional path to local Qwen GGUF model
QWEN_MODEL_PATH=ai/models/qwen/Qwen3-0.6B-Q4_0.gguf

# SLA Auto-escalation threshold in hours
AUTO_ESCALATION_HOURS=48

# WebSocket heartbeat interval in milliseconds
WS_HEARTBEAT_MS=30000

# Legacy Neo4j Connection (Unused by active routers)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
