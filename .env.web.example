# ==============================================================================
# JanSetu Web Frontend — Environment Configuration (.env.example)
# ==============================================================================
# Place in apps/web/.env or root .env (Vite mode)
# Variables exposed to browser must begin with VITE_

# Base API URL for REST calls (leave empty to use Vite proxy in local dev)
VITE_API_BASE=http://localhost:3000

# Backend origin for dashboard RPC calls and WebSocket connection derivation
VITE_BACKEND_URL=http://localhost:3000

# Explicit WebSocket URL if deployed separately
VITE_WS_URL=ws://localhost:3000
