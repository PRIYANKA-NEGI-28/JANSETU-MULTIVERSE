# ==============================================================================
# JanSetu IoT Edge Gateway — Environment Configuration (.env.example)
# ==============================================================================
# Place in IOT/python/.env or iot/python/.env

# Target cloud backend endpoint URL
BACKEND_URL=http://localhost:3000

# Hardware device identifier
DEVICE_ID=UNO_Q_01

# HTTP request timeout in seconds
REQUEST_TIMEOUT=10.0

# Maximum backoff retry delay in seconds
MAX_BACKOFF_DELAY=60.0

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
