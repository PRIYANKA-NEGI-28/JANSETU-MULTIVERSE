# ==============================================================================
# JanSetu IoT Edge Gateway — Environment Configuration Template
# ==============================================================================
# Target: iot/python/.env (Linux MPU on Arduino UNO Q)

# Target cloud backend endpoint URL (No trailing slash, NO hardcoded Render URLs)
BACKEND_URL=http://localhost:3000

# Hardware device identifier (must match iot_devices record in DB)
DEVICE_UID=UNO_Q_01

# Cryptographic HMAC-SHA256 signing secret for X-Signature
DEVICE_HMAC_SECRET=jansetu-iot-dev-secret

# Operational polling interval from Arduino MCU (seconds)
POLL_INTERVAL_SEC=1.0

# Periodic health and telemetry heartbeat interval (seconds, 300 = 5 minutes)
HEARTBEAT_INTERVAL_SEC=300.0

# HTTP request timeout in seconds (strict TLS enabled)
REQUEST_TIMEOUT=10.0

# Maximum backoff retry delay in seconds
MAX_BACKOFF_DELAY=60.0

# SQLite store-and-forward outbox path
OUTBOX_DB_PATH=outbox.db

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Rotating log file path (1MB max, 3 backups to protect flash storage)
LOG_FILE_PATH=jansetu_iot.log
MAX_LOG_BYTES=1048576
LOG_BACKUP_COUNT=3
