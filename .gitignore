# ==============================================================================
# JanSetu Multiverse — Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (NEVER COMMIT CREDENTIALS)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.expo

# Exceptions: Allow template/example files
!.env.example
!.env.*.example
!*.env.example

# Service account & API credentials
*firebase-service-account*.json
firebase-service-account.json
*service-account*.json
google-services.json
GoogleService-Info.plist
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.cert
*.crt

# Database backups & snapshots
backups/
*.sql.gz
*.sql.sha256

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
web_modules/
.pnpm-store/
.npm/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
yarn-error.log*
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Build Artifacts & Bundles
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.nuxt/
.temp/
.cache/
.parcel-cache/
.docusaurus/
.serverless/
.fusebox/
.svelte-kit/
*.tsbuildinfo
*.tgz
.turbo/
**/.turbo/

# Expo & React Native Build Outputs
.expo/
**/web-build/
expo-export-test/
**/expo-export-test/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ipa
*.hbc
output.json

# ------------------------------------------------------------------------------
# 4. Large AI / ML Model Weights & Binaries
# ------------------------------------------------------------------------------
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.dlc
*.tflite
*.safetensors
*.weights

# ------------------------------------------------------------------------------
# 5. Local Storage, Databases & User Uploads
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
jansetu-backend/uploads/
uploads/
**/uploads/
storage/
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Python Toolchain & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 7. Native Mobile Toolchains (Android / iOS)
# ------------------------------------------------------------------------------
.gradle/
**/android/build/
**/android/.gradle/
**/android/app/build/
local.properties
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties
.gradletasknamecache
xcuserdata/
*.xcscmblueprint
*.xccheckout
Pods/
Podfile.lock

# ------------------------------------------------------------------------------
# 8. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.cora/

# ------------------------------------------------------------------------------
# 9. Test Artifacts & Playwright Reports
# ------------------------------------------------------------------------------
test-results/
playwright-report/
*.log
